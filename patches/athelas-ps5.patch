diff -ruN a/sdk/runtime/kernel/memory.cpp b/sdk/runtime/kernel/memory.cpp
--- a/sdk/runtime/kernel/memory.cpp	2026-11-07 15:26:12.363531140 -0300
+++ b/sdk/runtime/kernel/memory.cpp	2026-11-07 15:26:18.018888829 -0300
@@ -11,6 +11,8 @@
 #ifdef _WIN32
 #define WIN32_LEAN_AND_MEAN
 #include <windows.h>
+#elif defined(__PROSPERO__)
+#include <ps5platform/shm.h>
 #else
 #include <sys/mman.h>
 #endif
@@ -20,6 +22,51 @@
 static uint8_t* g_base = nullptr;
 static std::recursive_mutex g_lock;
 
+#ifdef __PROSPERO__
+// PS5 (rotk-ps5): host pages are 16 KB, four guest pages each, and a title may not issue raw mmap syscalls. The
+// 4 GB guest space is a reserved range; physical memory is one shared object mapped into both of its windows, and a
+// commit maps 16 KB host pages taken from 16 MB backing slabs. A host page goes back to the pool once all four of its
+// guest pages are decommitted.
+namespace ps5 {
+constexpr size_t kHostPage = 0x4000;
+constexpr size_t kSlabSize = 16u << 20;
+constexpr uint32_t kChunksPerSlab = uint32_t(kSlabSize / kHostPage);
+static ps5_shm g_ram;
+static std::vector<ps5_shm> g_slabs;
+static std::vector<uint32_t> g_free;             // free chunks: slab * kChunksPerSlab + index
+static std::vector<uint32_t> g_mapped;           // per host page of the guest space: chunk + 1, or 0
+
+static bool MapChunk(uint64_t host_page) {
+    if (g_free.empty()) {
+        ps5_shm slab{};
+        if (ps5_shm_create(kSlabSize, &slab)) return false;
+        uint32_t s = uint32_t(g_slabs.size());
+        g_slabs.push_back(slab);
+        for (uint32_t i = kChunksPerSlab; i-- > 0;) g_free.push_back(s * kChunksPerSlab + i);
+        LOGI("memory: backing slab %u (%u MB committed so far)", s, unsigned((s * kSlabSize) >> 20));
+    }
+    uint32_t chunk = g_free.back();
+    void* at = g_base + host_page * kHostPage;
+    void* view = nullptr;
+    if (ps5_shm_map(&g_slabs[chunk / kChunksPerSlab], size_t(chunk % kChunksPerSlab) * kHostPage, kHostPage, at,
+                    PS5_SHM_READ | PS5_SHM_WRITE, PS5_SHM_FIXED, &view) || view != at)
+        return false;
+    g_free.pop_back();
+    std::memset(view, 0, kHostPage);  // a recycled chunk keeps what it held
+    g_mapped[size_t(host_page)] = chunk + 1;
+    return true;
+}
+
+static void UnmapChunk(uint64_t host_page) {
+    uint32_t chunk = g_mapped[size_t(host_page)];
+    if (!chunk) return;
+    ps5_shm_unmap(g_base + host_page * kHostPage, kHostPage, PS5_SHM_KEEP_RESERVED);
+    g_mapped[size_t(host_page)] = 0;
+    g_free.push_back(chunk - 1);
+}
+}  // namespace ps5
+#endif
+
 uint8_t* Base() { return g_base; }
 
 // physical memory shows at 0x80000000 and again at 0xF0000000 (write combined view)
@@ -54,6 +101,26 @@
         UnmapViewOfFile(b + kContiguousBase);
         UnmapViewOfFile(b + kWriteCombineBase);
     }
+#elif defined(__PROSPERO__)
+    void* p = nullptr;
+    if (ps5_vrange_reserve(size_t(size), reinterpret_cast<void*>(0x100000000ull), ps5::kHostPage, &p) == 0 && p) {
+        uint8_t* b = static_cast<uint8_t*>(p);
+        void* first = nullptr;
+        void* second = nullptr;
+        bool ok = ps5_shm_create(kMappedPhysical, &ps5::g_ram) == 0;
+        ok = ok && ps5_shm_map(&ps5::g_ram, 0, kMappedPhysical, b + kContiguousBase, PS5_SHM_READ | PS5_SHM_WRITE,
+                               PS5_SHM_FIXED, &first) == 0 && first == b + kContiguousBase;
+        ok = ok && ps5_shm_map(&ps5::g_ram, 0, kMappedPhysical, b + kWriteCombineBase, PS5_SHM_READ | PS5_SHM_WRITE,
+                               PS5_SHM_FIXED, &second) == 0 && second == b + kWriteCombineBase;
+        if (ok) {
+            std::memset(first, 0, kMappedPhysical);  // direct memory can come back holding another process's data
+            ps5::g_mapped.assign(size_t(size / ps5::kHostPage), 0);
+            g_base = b;
+        } else {
+            LOGE("memory: the physical windows could not be mapped");
+            ps5_vrange_release(p, size_t(size));
+        }
+    }
 #else
     void* p = mmap(reinterpret_cast<void*>(0x100000000ull), size, PROT_NONE, MAP_PRIVATE | MAP_ANONYMOUS | MAP_NORESERVE, -1, 0);
     g_base = p == MAP_FAILED ? nullptr : static_cast<uint8_t*>(p);
@@ -84,6 +151,13 @@
         LOGE("memory: commit %08X+%X failed", first, uint32_t(end - first));
         return false;
     }
+#elif defined(__PROSPERO__)
+    for (uint64_t hp = first / ps5::kHostPage; hp * ps5::kHostPage < end; hp++) {
+        if (ps5::g_mapped[size_t(hp)] || ps5::MapChunk(hp)) continue;
+        LOGE("memory: commit %08X+%X failed at host page %08llX", first, uint32_t(end - first),
+             (unsigned long long)(hp * ps5::kHostPage));
+        return false;
+    }
 #else
     if (mprotect(g_base + first, size_t(end - first), PROT_READ | PROT_WRITE)) {
         LOGE("memory: commit %08X+%X failed", first, uint32_t(end - first));
@@ -101,6 +175,17 @@
     std::lock_guard<std::recursive_mutex> lock(g_lock);
 #ifdef _WIN32
     VirtualFree(g_base + first, size_t(end - first), MEM_DECOMMIT);
+#elif defined(__PROSPERO__)
+    // the guest pages read as zero when committed again; a host page is released once none of its four is committed
+    for (uint64_t p = first; p < end; p += kPage) {
+        if (!g_committed[size_t(p >> 12)]) continue;
+        if (ps5::g_mapped[size_t(p / ps5::kHostPage)]) std::memset(g_base + p, 0, kPage);
+        g_committed[size_t(p >> 12)] = 0;
+    }
+    for (uint64_t hp = first / ps5::kHostPage; hp * ps5::kHostPage < end; hp++) {
+        size_t g = size_t(hp * (ps5::kHostPage / kPage));
+        if (!g_committed[g] && !g_committed[g + 1] && !g_committed[g + 2] && !g_committed[g + 3]) ps5::UnmapChunk(hp);
+    }
 #else
     madvise(g_base + first, size_t(end - first), MADV_DONTNEED);
     mprotect(g_base + first, size_t(end - first), PROT_NONE);
