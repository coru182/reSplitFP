+// visibility tests
+
+bool VkBackend::EnsureQueries() {
+    if (query_pool_) return true;
+    if (query_failed_ || !device_ || !vkCreateQueryPool || !vkGetQueryPoolResults || !vkCmdResetQueryPool) {
+        query_failed_ = true;
+        return false;
+    }
+    VkQueryPoolCreateInfo qi{VK_STRUCTURE_TYPE_QUERY_POOL_CREATE_INFO};
+    qi.queryType = VK_QUERY_TYPE_OCCLUSION;
+    qi.queryCount = kQueriesPerSlot * kFrames;
+    VkResult r = vkCreateQueryPool(device_, &qi, nullptr, &query_pool_);
+    if (r != VK_SUCCESS) {
+        LOGE("vulkan: occlusion queries unavailable (%s), visibility tests read as fully visible", ResultName(r));
+        query_pool_ = VK_NULL_HANDLE;
+        query_failed_ = true;
+        return false;
+    }
+    LOGI("vulkan: visibility tests counted by occlusion queries%s", query_precise_ ? "" : " (not precise on this card)");
+    // the open command buffer's entries are reset now; the other slots' when their next one begins
+    if (recording_) {
+        bool was = rendering_;
+        Target *rt = render_rt_, *ds = render_ds_;
+        EndRendering();
+        vkCmdResetQueryPool(frames_[frame_].cmd, query_pool_, frame_ * kQueriesPerSlot, kQueriesPerSlot);
+        query_used_[frame_] = 0;
+        if (was) BeginRendering(rt, ds);
+    }
+    return true;
+}
+
+void VkBackend::StartQuerySegment() {
+    if (!query_pool_ || !query_open_ || query_entry_ >= 0 || !rendering_ || !recording_) return;
+    if (query_used_[frame_] >= kQueriesPerSlot) {
+        LOG_FIRST(2, "vulkan: more than %u visibility test renderings in a frame: the rest are not counted", kQueriesPerSlot);
+        return;
+    }
+    uint32_t entry = frame_ * kQueriesPerSlot + query_used_[frame_]++;
+    vkCmdBeginQuery(frames_[frame_].cmd, query_pool_, entry, query_precise_ ? VK_QUERY_CONTROL_PRECISE_BIT : 0);
+    query_entry_ = entry;
+    // counted at our resolution on the target drawn to, given back in the title's pixels
+    const Target* t = render_ds_ ? render_ds_ : render_rt_;
+    float ratio = t && t->w && t->h ? float(t->gw) * float(t->gh) / (float(t->w) * float(t->h)) : 1.0f;
+    query_segs_[frame_].push_back({query_open_, entry, ratio});
+    query_tests_[query_open_].open++;
+}
+
+void VkBackend::StopQuerySegment() {
+    if (query_entry_ < 0) return;
+    vkCmdEndQuery(frames_[frame_].cmd, query_pool_, uint32_t(query_entry_));
+    query_entry_ = -1;
+}
+
+void VkBackend::PublishQuery(const QueryTest& t) {
+    if (t.index == ~0u) return;
+    std::lock_guard<std::mutex> lock(query_lock_);
+    QueryCount& c = query_counts_[t.index];
+    c.pixels = uint32_t(std::min(std::round(t.pixels), 4294967295.0));
+    c.have = true;
+}
+
+// the slot's GPU work is done: its entries' counts go to their tests, and a test with all its counts in is finished
+void VkBackend::ReadQueries(uint32_t slot) {
+    for (const QuerySeg& seg : query_segs_[slot]) {
+        uint64_t n = 0;
+        VkResult r = vkGetQueryPoolResults(device_, query_pool_, seg.entry, 1, sizeof(n), &n, sizeof(n), VK_QUERY_RESULT_64_BIT);
+        if (r != VK_SUCCESS) n = 0;
+        auto it = query_tests_.find(seg.test);
+        if (it == query_tests_.end()) continue;
+        QueryTest& t = it->second;
+        t.pixels += double(n) * seg.ratio;
+        if (t.open) t.open--;
+        if (!t.open && t.ended) {
+            PublishQuery(t);
+            query_tests_.erase(it);
+        }
+    }
+    query_segs_[slot].clear();
+}
+
+void VkBackend::BeginQuery() {
+    if (!EnsureQueries()) return;
+    if (query_open_) EndQuery(~0u);  // one left open: ended unnamed
+    query_open_ = ++query_ids_ ? query_ids_ : ++query_ids_;
+    query_tests_[query_open_] = QueryTest{};
+    StartQuerySegment();
+}
+
+void VkBackend::EndQuery(uint32_t index) {
+    if (!query_open_) return;
+    StopQuerySegment();
+    auto it = query_tests_.find(query_open_);
+    query_open_ = 0;
+    if (it == query_tests_.end()) return;
+    it->second.index = index;
+    it->second.ended = true;
+    if (!it->second.open) {  // nothing drawn, or every count already in
+        PublishQuery(it->second);
+        query_tests_.erase(it);
+    }
+}
+
+bool VkBackend::QueryResult(uint32_t index, uint32_t& pixels) {
+    std::lock_guard<std::mutex> lock(query_lock_);
+    auto it = query_counts_.find(index);
+    if (it == query_counts_.end() || !it->second.have) return false;
+    pixels = it->second.pixels;
+    return true;
+}
