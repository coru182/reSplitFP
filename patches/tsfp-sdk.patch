 using namespace gpu::vk;
 
+// The stall report: a thread of its own logs, once, when no frame has been shown for 5 seconds, and what the renderer
+// is waiting on then (the GPU's fence, the next screen image, the queue), or that it waits on nothing: the game
+// itself stopped presenting. A frozen or black screen then says in the log which side stopped.
+std::atomic<int64_t> g_last_frame_ms{0};
+std::atomic<const char*> g_waiting{nullptr};
+int64_t NowMs() {
+    return std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now().time_since_epoch()).count();
+}
+struct Waiting {
+    explicit Waiting(const char* what) { g_waiting = what; }
+    ~Waiting() { g_waiting = nullptr; }
+};
+void StartStallReport() {
+    static std::once_flag once;
+    std::call_once(once, [] {
+        std::thread([] {
+            bool told = false;
+            for (;;) {
+                std::this_thread::sleep_for(std::chrono::seconds(1));
+                int64_t last = g_last_frame_ms.load();
+                if (!last) continue;
+                int64_t idle = NowMs() - last;
+                if (idle >= 5000 && !told) {
+                    const char* w = g_waiting.load();
+                    LOGE("vulkan: no frame shown for %lld s: %s", (long long)(idle / 1000),
+                         w ? w : "the renderer waits on nothing (the game has stopped presenting)");
+                    told = true;
+                } else if (idle < 5000 && told) {
+                    LOGE("vulkan: frames are shown again");
+                    told = false;
+                }
+            }
+        }).detach();
+    });
+}
